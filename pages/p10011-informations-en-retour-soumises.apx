page 10011 (
    name: Informations en retour soumises
    alias: INFORMATIONS-EN-RETOUR-SOUMISES
    title: Informations en retour
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }
    config {
        buildOption: @fonctionnalité-informations-en-retour
    }

    region informations-en-retour-soumises (
        name: Informations en retour soumises
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--wizard
                t-Alert--customIcons
                t-Alert--success
            ]
            icon: fa-check-circle
        }
    )

    button close (
        buttonName: CLOSE
        label: Fermer
        layout {
            sequence: 20
            region: @informations-en-retour-soumises
            slot: EDIT
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: w40p
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction fermer-la-boîte-de-dialogue (
        name: Fermer la boîte de dialogue
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

