    region nouveau-2 (
        name: Nouveau
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox(1, 'V'||REC_POSTE_VACAN.ID||' '||'P'||(select IDFONCTION from FONCTION where IDFONCTION = REC_DEMANDE_PERS.IDFONCTION) ) selected,
                       REC_POSTE_VACAN.ID,
                       REC_POSTE_VACAN.IDPLAN_RECRUTEMENT,
                       (CASE
                            When REC_DEMANDE_PERS.POSTE_FONCTION = 'f' Then (select LIBELLE from FONCTION where IDFONCTION = REC_DEMANDE_PERS.IDFONCTION)
                            When REC_DEMANDE_PERS.POSTE_FONCTION = 'p' Then (select LIBELLE from CONTACT_POSTE where IDPOSTE = REC_DEMANDE_PERS.IDPOSTE)
                       END) Poste_Fonction,
                       (CASE
                            When REC_DEMANDE_PERS.POSTE_FONCTION = 'f' Then (select IDFONCTION from FONCTION where IDFONCTION = REC_DEMANDE_PERS.IDFONCTION)
                            When REC_DEMANDE_PERS.POSTE_FONCTION = 'p' Then (select IDPOSTE from CONTACT_POSTE where IDPOSTE = REC_DEMANDE_PERS.IDPOSTE)
                       END) idposte_idFonction,
                       rec.DATE_DEBUT,
                       rec.DATEFIN,
                       rec.DATE_CLOTURE,
                       REC_DEMANDE_PERS.QUALIFICATION_MIN,
                       REC_DEMANDE_PERS.QUALIFICATION_MAX,   
                       REC_DEMANDE_PERS.NBR_ANNEE_EXPERIENCE ,
                       rec.DESCIPTION_OFFRE	,
                       rec.DESCRITION_POSTULE
                
                  from REC_POSTE_VACAN, REC_DEMANDE_PERS, REC_PLAN_RECRUTEMENT rec
                 where rec.IDREC_PLAN_RECRUTEMENT = REC_POSTE_VACAN.IDPLAN_RECRUTEMENT
                 and REC_DEMANDE_PERS.IDREC_DEMANDE_PERS = REC_POSTE_VACAN.IDDEMANDE
                and rec.STATUT = 'v'
                and instr(rec.TYPE_CANDIDATURE,'externe')>0
                and to_date(rec.DATE_CLOTURE) > sysdate
                ```
        }
        layout {
            sequence: 20
            parentRegion: @nouveaun
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

