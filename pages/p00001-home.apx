            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--iconLeft
                t-Button--hoverIconPush
            ]
            icon: fa-arrows-h
        }
        behavior {
            action: redirectOtherApp
            target: {
                app: 101
                page: 9999
                clearCache: 9999
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: CONNEXION
        }
    )

    button crer (
        buttonName: Crer
        label: Créer un compte
        layout {
            sequence: 10
            region: @liste-des-postes-vacants
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--simple
                t-Button--iconLeft
                t-Button--hoverIconPush
            ]
            icon: fa-user
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
                clearCache: 2
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: CREER
