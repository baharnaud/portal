    region nouveaun (
        name: NouveauN
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: regionN
            regionDisplaySelector: true
        }
    )

    region recherche (
        name: Recherche
        type: smartFilters
        source {
            filteredRegion: @nouveau-2
        }
        layout {
            sequence: 10
            slot: body
            column: 2
            columnSpan: 10
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            compactNosThreshold: 10000
            showTotalRowCount: true
            totalRowCountLabel: "Total : "
        }

        filter P1_SEARCH (
            type: search
            label {
                label: Rechercher
            }
            layout {
                sequence: 10
            }
        )

    )

    button connexion (
        buttonName: Connexion
        label: Connexion
        layout {
            sequence: 30
            region: @liste-des-postes-vacants
            slot: next
        }
        appearance {
