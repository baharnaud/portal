page 1 (
    name: Page d'accueil
    alias: HOME
    title: Servive en Ligne
    appearance {
        pageTemplate: @minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-HeroRegion-title {
              margin: auto;
              font-size: 30px;
              font-style: oblique;
              font-weight: bold;
              text-shadow: 0 1px 0 #ccc, 0 2px 0 #c9c9c9, 0 3px 0 #bbb, 
              0 4px 0 #b9b9b9, 0 5px 0 #aaa, 0 6px 1px rgba(0,0,0,.1), 0 0 5px rgba(0,0,0,.1), 
              0 1px 3px rgba(0,0,0,.3), 0 3px 5px rgba(0,0,0,.2), 0 5px 10px rgba(0,0,0,.25), 
              0 10px 10px rgba(0,0,0,.2), 0 20px 20px rgba(0,0,0,.15);
            }
            .t-Header-branding, .t-HeroRegion-icon {
                background-color: #0076df;
                background: #0070ff;
            }
            #main {
              background: #0ddbfd08;
            }
            .a-IRR-singleRow-value {
              color: blue;
              font-size: 16px;
              font-weight: bold;
              font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
            }
            .a-IRR-singleRow-name{
              color: #000;
              font-size: 16px;
              font-weight: bold;
              font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif
            }
            #regionN {
                border: 1px solid rgb(96, 204, 236);
                border-radius: 15px;
            }
            
            /* DESIGN du bouton <Se créer>*/
            .t-BreadcrumbRegion-buttons {
                /* position: relative; */
                transform: translate(-50%,-50%);
                /* margin-left: 30%; */
                margin-right: -25%;
            }
            #CREER {
                /* position: absolute; */
                text-align: center;
                width: 220px;
                padding: 10px;
                font-size: 16px;
                color: #15f4ee;
                font-family: poppins;
                font-weight: 300;
                border: 5px solid #15f4ee;
                text-transform: uppercase;
                /* letter-spacing: 8px; */
                cursor: pointer;
                border-radius: 100px;
                transition: 1.5s;
            }
            #CONNEXION {
                    /* position: absolute; */
                text-align: center;
                width: 220px;
                padding: 10px;
                font-size: 16px;
                color: #0df1b8;
                font-family: poppins;
                font-weight: 300;
                border: 5px solid #0df1b8;
                text-transform: uppercase;
                /* letter-spacing: 8px; */
                cursor: pointer;
                border-radius: 100px;
                transition: 1.5s;
                background-color: transparent;
            }
            #CREER:hover {
                box-shadow: 0 5px 50px 0 #15f4ee inset, 0 5px 50px 0 #15f4ee,
                            0 5px 50px 0 #15f4ee inset, 0 5px 50px 0 #15f4ee;
                text-shadow: 0 0 5px #15f4ee,0 0 5px #15f4ee;
            }
            #CONNEXION:hover {
                box-shadow: 0 5px 50px 0 #0df1b8 inset, 0 5px 50px 0 #0df1b8,
                            0 5px 50px 0 #0df1b8 inset, 0 5px 50px 0 #0df1b8;
                text-shadow: 0 0 5px #0df1b8,0 0 5px #0df1b8;
            }
            
            /* DESIGN Grand Titre */
            .t-BreadcrumbRegion-breadcrumb .h2{
               color: #b3ffab;
            }
            .trait {
                width: 200px;
                height: 2px;
                background-image: linear-gradient(-225deg, #231557 0%, #44107A 29%, #FF1361 67%, #FFF800 100%);
                /* background-color: #15f4ee; */
            }
            ```
    }
    security {
        authentication: public
        formAutoComplete: false
    }

    region liste-des-postes-vacants (
        name: Liste des Postes Vacants
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
            icon: fa-rub
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region nouveau (
        name: Nouveau
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox(1, 'V'||REC_POSTE_VACAN.ID||' '||'P'||CONTACT_POSTE.IDPOSTE) selected,
                       REC_POSTE_VACAN.ID,
                       REC_POSTE_VACAN.IDPLAN_RECRUTEMENT,
                       CONTACT_POSTE.LIBELLE,
                       CONTACT_POSTE.IDPOSTE,
                       rec.DATE_DEBUT,
                       rec.DATE_CLOTURE,
                       REC_DEMANDE_PERS.QUALIFICATION_MIN,
                       REC_DEMANDE_PERS.QUALIFICATION_MAX,   
                       REC_DEMANDE_PERS.NBR_ANNEE_EXPERIENCE ,
                       rec.DESCIPTION_OFFRE	,
                       rec.DESCRITION_POSTULE
                
                  from REC_POSTE_VACAN, REC_DEMANDE_PERS, CONTACT_POSTE, REC_PLAN_RECRUTEMENT rec
                 where rec.IDREC_PLAN_RECRUTEMENT = REC_POSTE_VACAN.IDPLAN_RECRUTEMENT
                 and REC_DEMANDE_PERS.IDREC_DEMANDE_PERS = REC_POSTE_VACAN.IDDEMANDE
                 and REC_DEMANDE_PERS.IDPOSTE = CONTACT_POSTE.IDPOSTE
                and rec.STATUT = 'v'
                and instr(rec.TYPE_CANDIDATURE,'externe')>0
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            columnSpan: 10
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 291402892843264124
        }

