    pageItem P2_UTILISATEUR (
        type: displayOnly
        label {
            label: <MARQUEE SCROLLAMOUNT="2">Votre matricule sera votre login veuillez le conserver ! </MARQUEE>
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 40
            region: @candidat
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Retour
        layout {
            sequence: 10
            region: @boutons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
            icon: fa-reply
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Valider
        layout {
            sequence: 40
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
            requiresConfirmation: true
        }
        confirmation {
            message: Voulez-vous valider ?
            style: success
        }
        serverSideCondition {
            type: itemIsNull
            item: P2_IDADHERENT
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @boutons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_IDADHERENT
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_IDADHERENT
        }
    )

    dynamicAction affect-matr (
        name: affect matr
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P2_MAT
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P2_MAT
                itemsToSubmit: P2_MAT
            }
            affectedElements {
                selectionType: items
                items: P2_MAT_1
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction creer-un-matricule (
        name: CREER un Matricule
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    
                        v_sqt number;
                        
                    begin
                    
                    
                    select MATRICULE_SQT.nextval into v_sqt from dual;
                    
                    return 'CAND00'||v_sqt;
                    
                    end;
                    ```
            }
            affectedElements {
                selectionType: items
                items: [
                    P2_MATRICULE
                    P2_MAT
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation email (
        name: email
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    v_nb number;
                begin
                
                select count(*) into v_nb from ADHERENT where upper(email) = upper(:P2_AUTREPRENOMS);
                
                if(v_nb > 0)then
                    return 'Un compte utilisant cet eamil existe';
                end if;
                
                end;
                ```
        }
        error {
            associatedItem: @P2_AUTREPRENOMS
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation mot-de-passe-différent (
        name: mot de passe différent
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if(:P2_MOT_PASSE !=:P2_CONFIRMER )then
                
                    return 'Les deux mots de passes sont différent';
                
                end if;
                ```
        }
        error {
            associatedItem: @P2_MOT_PASSE
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fermer-la-boîte-de-dialogue (
        name: Fermer la boîte de dialogue
        type: closeDialog
        settings {
            itemsToReturn: P2_MAT
            showSuccessMessages: false
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 207183713907254442
        }
        serverSideCondition {
            type: never
        }
    )

    process initialiser-le-panneau-candidat (
        name: Initialiser le panneau Candidat
        type: formInitialization
        formRegion: @candidat
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 207182930173254440
        }
    )

    process modifier (
        name: MODIFIER
        type: executeCode
        source {
            plsqlCode: update ADHERENT set IDADHERENT2 = IDADHERENT,Date_Effet = sysdate	 where IDADHERENT =:P2_IDADHERENT;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 207796164465740667
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process traiter-le-panneau-candidat (
        name: Traiter le panneau Candidat
        type: formAutoRowProcessing
        formRegion: @candidat
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 207183304212254442
        }
    )

    branch (
        name: Aller à la page http://192.168.1.129:9494/ords/f?p=110
        execution {
            sequence: 10
        }
        behavior {
            target: {
                type: otherApp
                app: 101
                page: 9999
                items: {
                    P9999_SESSION: &P2_SESSION.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

