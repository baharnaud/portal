page 2 (
    name: Créer un Candidat
    alias: ANDIDAT
    title: Créer un Candidat
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline:
            ```css
            #P2_NOM ,#P2_PRENOMS,#P2_AUTREPRENOMS,#P2_SITUATIONMATRIMONIALE,#P2_TITRE,#P2_DATENAISSANCE,#P2_IDPAYS,#P2_MOT_PASSE,#P2_CONFIRMER{
              border: 3px solid #000;
            }
            #P2_NOM_LABEL,#P2_PRENOMS_LABEL,#P2_SITUATIONMATRIMONIALE_LABEL,#P2_AUTREPRENOMS_LABEL,#P2_TITRE_LABEL,
            #P2_DATENAISSANCE_LABEL,#P2_IDPAYS_LABEL,#P2_MOT_PASSE_LABEL,#P2_CONFIRMER_LABEL,#P2_GENRE_LABEL {
              font-size: 18px;
              color:#000;
            }
            marquee {
              color: blue;
              font-size: 18px;
              font-style: oblique;
              font-weight: bold;
            }
            #P2_MAT_1 {
              font-size: 18px;
              color: red;
              font-family: open sans;
              font-weight: 500;
            }
            #P2_MAT_1_LABEL {
              color: #000;
              font-size: 18px;
              text-transform: uppercase;
              font-weight: bold;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region candidat (
        name: Candidat
        type: form
        source {
            location: localDatabase
            tableName: ADHERENT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region chemin-de-navigation (
        name: Chemin de navigation
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P2_ACTIF (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @candidat
            slot: regionBody
        }
        source {
            formRegion: @candidat
            column: ACTIF
            dataType: varchar2
        }
        default {
            type: static
            staticValue: o
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P2_AUTREPRENOMS (
        type: textField
        label {
            label: Email
            alignment: left
        }
        settings {
            subtype: email
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @candidat
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @candidat
            column: EMAIL
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P2_CONFIRMER (
        type: password
        label {
            label: Confirmer Mot de passe
            alignment: left
        }
        layout {
            sequence: 180
            region: @candidat
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P2_DATENAISSANCE (
        type: datePickerJquery
        label {
            label: Date de naissance
            alignment: left
