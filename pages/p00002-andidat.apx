        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        source {
            formRegion: @candidat
            column: DATENAISSANCE
            dataType: date
        }
        security {
            encryptSessionState: false
        }
    )

