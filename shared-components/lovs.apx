lov rec-plan-recrutement (
    name: REC PLAN RECRUTEMENT
    source {
        tableName: REC_PLAN_RECRUTEMENT
    }
    columnMapping {
        return: IDREC_PLAN_RECRUTEMENT
        display: LIBELLE
        defaultSort: LIBELLE
    }
)

lov situation-matrimoniale (
    name: SITUATION MATRIMONIALE
    source {
        location: staticValues
    }

    entry célibataire (
        sequence: 1
        display: Célibataire
        return: c
    )

    entry divorcé (
        sequence: 3
        display: Divorcé
        return: d
    )

    entry marié-e (
        sequence: 2
        display: Marié(e)
        return: m
    )

)

lov titre (
    name: TITRE
    source {
        tableName: TITRE
    }
    columnMapping {
        return: DESIGNATION
        display: DESIGNATION
        defaultSort: DESIGNATION
    }
)

lov titre-adherent (
    name: TITRE ADHERENT
    source {
        location: staticValues
    }

    entry madame (
        sequence: 2
        display: Madame
        return: madame
    )

    entry mademoiselle (
        sequence: 3
        display: Mademoiselle
        return: mademoiselle
    )

    entry monsieur (
        sequence: 1
        display: Monsieur
        return: monsieur
    )

)

