fieldTemplate standard (
    name: Standard
    templateClass: optionalLabel
    label {
        before:
            ```html
                <label for="#CURRENT_ITEM_NAME#" id="#LABEL_ID#" data-tooltip="#CURRENT_ITEM_HELP_TEXT#">
            
            ```
        after:
            ```html
                </label>
            
            ```
    }
    item {
        before:
            ```html
                #ERROR_TEMPLATE#
            
            ```
    }
    error {
        errorTemplate:
            ```html
            <span class="ma-error-message">#ERROR_MESSAGE#</span>
            
            ```
    }
    fieldContainer {
        beforeLabelAndItem:
            ```html
            <div id="#CURRENT_ITEM_NAME#_CONTAINER" class="ma-field-container input-field #ITEM_CSS_CLASSES#">
            
            ```
        afterLabelAndItem:
            ```html
            </div>
            
            
            ```
    }
    advanced {
        identifier: STANDARD
    }

    templateOption checkbox-alternate (
        name: Checkbox & Radio - 2nd Look
        sequence: 10
        appearance {
            cssClasses: ma-alternate-look
        }
        advanced {
            identifier: CHECKBOX_ALTERNATE
        }
    )

    templateOption no-label (
        name: Hide Label
        sequence: 1
        appearance {
            cssClasses: item-no-label
        }
        advanced {
            identifier: NO_LABEL
        }
    )

    templateOption truncate-text-overflow (
        name: Display Only - Truncate Text
        sequence: 11
        appearance {
            cssClasses: truncate
        }
        advanced {
            identifier: TRUNCATE_TEXT_OVERFLOW
        }
    )

    templateOption field-center (
        name: Center
        group: @item/field-alignment
        sequence: 2
        appearance {
            cssClasses: center-align
        }
        advanced {
            identifier: FIELD_CENTER
        }
    )

    templateOption field-left (
