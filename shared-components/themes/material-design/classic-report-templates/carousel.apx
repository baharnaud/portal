classicReportTemplate carousel (
    name: Carousel_
    templateClass: horizontalBorder
    type: namedColumn
    reportTemplate {
        top: <div class="carousel carousel-slider #COMPONENT_CSS_CLASSES#">
        bottom: </div>
    }
    rowTemplate1 {
        template:
            ```html
            <div class="carousel-item promo center-align">
              <img class="display_image apex-item-image" src="#IMG_SOURCE#"/>
              <div class="promo-caption">#TITLE#</div>
              <div class="light m-t-1">#BODY#</div>
            </div>
            ```
    }
    advanced {
        identifier: CAROUSEL
    }
)

