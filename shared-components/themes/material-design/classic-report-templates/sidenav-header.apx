classicReportTemplate sidenav-header (
    name: SideNav Header
    templateClass: custom3
    type: namedColumn
    reportTemplate {
        top: <div id="#REGION_STATIC_ID#_report" class="user-view #COMPONENT_CSS_CLASSES#">
        bottom: </div>
    }
    rowTemplate1 {
        template:
            ```html
            <div class="background">
                        <img class="responsive-img" src="#BACKGROUND_IMG#">
                    </div>
                    <a href="#PROFILE_LINK#"><img class="circle" src="#PROFILE_IMG#"></a>
                    <span class="name">#TEXT_LINE_1#</span>
                    <span class="email">#TEXT_LINE_2#</span>
            ```
    }
    advanced {
        identifier: SIDENAV_HEADER
    }
)

