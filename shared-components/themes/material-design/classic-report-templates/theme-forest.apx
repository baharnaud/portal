classicReportTemplate theme-forest (
    name: Theme Forest
    templateClass: standard
    type: namedColumn
    reportTemplate {
        top:
            ```html
            <div class="our-blog-carousel owl-carousel owl-loaded owl-drag">
                <div class="owl-stage-outer">
                    <div class="owl-stage" style="transform: translate3d(0px, 0px, 0px); transition: all 0s ease 0s; width: 2280px;">
                <div class="owl-item active" style="width: 350px; margin-right: 30px;">
            ```
        bottom:
            ```html
             </div>
            </div>       
            </div>
                   <div class="owl-nav">
                        <button type="button" role="presentation" class="owl-prev disabled">
                            <span class="icon icon-left"></span>
                        </button>
                        <button type="button" role="presentation" class="owl-next">
                            <span class="icon icon-right"></span>
                        </button>
                    </div>
                <div class="owl-dots disabled"></div>
            </div>
            ```
    }
    rowTemplate1 {
        template:
            ```html
                    <div class="item">
                        <div class="item-img">
                            <img src="#IMG_SRC#" alt="">
                        </div>
                        <div class="item-content-wrapper">
                            <div class="item-content">
                                <h3 class="item-title"><a href="#ARTICLE_LINK#">#ARTICLE_TITLE#</a></h3>
                                <p class="item-desc">
                                    #ARTICLE_RESUME#
                                </p>
                            </div>
                            <div class="row no-gutters">
                                <div class="col-8">
                                    <a href="#ARTICLE_LINK#" class="button-fill-gray">LIRE PLUS</a>
                                </div>
                                <div class="col-4 text-right">
                                    <div class="item-like">
                                        <span class="item-num">36</span>
                                        <span class="icon icon-hearts"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            ```
    }
    advanced {
        identifier: THEME_FOREST
    }
)

