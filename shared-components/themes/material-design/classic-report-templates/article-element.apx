classicReportTemplate article-element (
    name: Article_element
    templateClass: standard
    type: namedColumn
    reportTemplate {
        top: " "
        bottom: " "
    }
    rowTemplate1 {
        template:
            ```html
            <!-- blog-post -->
            <div class="blog-post hentry item-post">
            	
                    <!-- article title -->
                    <h1 class="post-title">#ARTICLE_NAME#</h1>
                
                    <div class="post-meta">
                        <span class="post-author"><a href="javascript:void(0)">#CREATED_BY#</a></span>
                        <span class="post-date published">#DATE_DEBUT#</span>
                    </div>
            
                    <div class="post-body post-content">
                        <img src="#ARTICLE_IMAGE_SOURCE#" title="#IMG_NAME#" width="100%" border="0">
                        <br>
                        <div><br></div>
                        <div width="100%">
                            #ARTICLE_CONTENT#
                        </div>
                    </div>
            </div>
            <!-- blog-post -->
            ```
    }
    advanced {
        identifier: LECTURE_ACTUALITE
    }
)

