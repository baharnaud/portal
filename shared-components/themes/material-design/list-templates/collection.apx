listTemplate collection (
    name: Collection
    templateClass: verticalOrderedList
    list {
        beforeEntries:
            ```html
            <ul class="collection #COMPONENT_CSS_CLASSES#">
            <li class="collection-header">
                <h4>#REGION_TITLE#</h4>
            </li>
            ```
        afterEntries: </ul>
    }
    entry {
        current:
            ```html
            <li class="collection-item">
                <a href="#LINK#">#TEXT#</a>
                <span class="badge">#A01#</span>
                <a href="#A02#" class="secondary-content">
                    <i class="#ICON_CSS_CLASSES#" aria-hidden="true"></i>
                </a>
            </li>
            ```
        noncurrent:
            ```html
            <li class="collection-item">
                <a href="#LINK#">#TEXT#</a>
                <span class="badge">#A01#</span>
                <a href="#A02#" class="secondary-content">
                    <i class="#ICON_CSS_CLASSES#" aria-hidden="true"></i>
                </a>
            </li>
            ```
    }
    attributeDescriptions {
        a01: Badge
        a02: Secondary Link
    }
    advanced {
        identifier: COLLECTION
    }

    templateOption with-header (
        name: With Header
        sequence: 1
        appearance {
            cssClasses: with-header
        }
        advanced {
            identifier: WITH_HEADER
        }
    )

)

