regionTemplate slider (
    name: Slider
    templateClass: custom3
    region {
        template:
            ```html
            <div id="#REGION_STATIC_ID#" class="ma-region slider #REGION_CSS_CLASSES#" #REGION_ATTRIBUTES#>
            	<div class="ma-region-body">#BODY#</div>
            	<ul class="slides">#SUB_REGIONS#</ul>
            </div>
            
            ```
    }
    subRegions {
        template:
            ```html
            <li>#SUB_REGION#</li>
            
            ```
    }
    advanced {
        identifier: SLIDER
    }

    templateOption slider-fullscreen (
        name: Fullscreen
        sequence: 1
        appearance {
            cssClasses: fullscreen
        }
        advanced {
            identifier: SLIDER_FULLSCREEN
        }
    )

    slot regionBody (
        name: Region Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
    )

    slot subRegions (
        name: Sub Regions
        staticId: SUB_REGIONS
        gridLayout {
            gridSupport: false
        }
    )

)

