regionTemplate promo (
    name: Promo
    templateClass: wizardRegionWithIcon
    region {
        template:
            ```html
            <div id="#REGION_STATIC_ID#" class="ma-region section promo #REGION_CSS_CLASSES#" #REGION_ATTRIBUTES#>
              <i class="ma-region-title #ICON_CSS_CLASSES#" aria-hidden="true"></i>
              <div class="ma-region-title promo-caption">#TITLE#</div>
              <div class="ma-region-body light m-t-1">#BODY#</div>
            </div>
            ```
    }
    advanced {
        identifier: PROMO
    }

    slot regionBody (
        name: Region Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
    )

    slot subRegions (
        name: Sub Regions
        staticId: SUB_REGIONS
    )

)

