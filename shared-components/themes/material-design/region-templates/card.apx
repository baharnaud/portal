regionTemplate card (
    name: Card
    templateClass: formRegion
    region {
        template:
            ```html
            <div id="#REGION_STATIC_ID#" class="ma-region ma-region-card card #REGION_CSS_CLASSES#" #REGION_ATTRIBUTES#>
            	<div class="card-content">
            		<div class="ma-flex-left">#PREVIOUS#</div>
            
            		<div class="ma-flex-content">
            			<div class="ma-region-header">
            				<div class="ma-flex-content">
            					<div class="ma-region-title card-title"><i class="#ICON_CSS_CLASSES#" aria-hidden="true"></i>#TITLE#</div>
            				</div>
            				<div class="ma-flex-right">#EDIT#</div>
            			</div>
            
            			<div class="ma-region-buttons ma-flex-justify">
            				<div class="ma-flex-left">#COPY#</div>
            				<div class="ma-flex-content"></div>
            				<div class="ma-flex-right">#EXPAND#</div>
            			</div>
            
            			<div class="ma-region-body t-Region-body">#BODY##SUB_REGIONS#</div>
            
            		</div>
            
            		<div class="ma-flex-right">#NEXT#</div>
            	</div>
            
            	<div class="ma-region-buttons ma-flex-justify card-action">
            		<div class="ma-flex-left">#CLOSE##HELP#</div>
            		<div class="ma-flex-center ma-flex-content">#CHANGE#</div>
            		<div class="ma-flex-right">#DELETE##CREATE##CREATE2#</div>
            	</div>
            </div>
            ```
    }
    advanced {
        identifier: CARD
    }

    templateOption card-hoverable (
        name: Hoverable
        sequence: 10
        appearance {
            cssClasses: hoverable
        }
        help {
            helpText: Adds an animation for a box shadow around the card.
        }
        advanced {
            identifier: CARD_HOVERABLE
        }
    )

    templateOption hide-title (
        name: Hide Title
        sequence: 20
        appearance {
            cssClasses: hide-title
        }
        advanced {
            identifier: HIDE_TITLE
        }
    )

    templateOption nobodypadding (
        name: Remove Body Padding
        sequence: 30
        appearance {
            cssClasses: ma-region--no-padding
        }
        help {
            helpText: Removes padding from region body.
        }
        advanced {
            identifier: NOBODYPADDING
        }
    )

    templateOption h1 (
        name: H1
        group: @region/title-size
        sequence: 1
        appearance {
            cssClasses: h1
        }
        advanced {
            identifier: H1
        }
    )

    templateOption h2 (
        name: H2
        group: @region/title-size
        sequence: 2
        appearance {
            cssClasses: h2
        }
        advanced {
            identifier: H2
        }
    )

    templateOption h3 (
        name: H3
