list barre-de-navigation-du-bureau (
    name: Barre de navigation du bureau

    entry a-propos-de (
        label: A propos de
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 20
        }
        userDefinedAttributes {
            2: icon-only
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @fonctionnalité-a-propos-de-la-page
        }
    )

    entry a-propos-de-la-page (
        label: A propos de la page
        icon {
            imageIconCssClasses: fa-info-circle-o
        }
        layout {
            sequence: 50
            parentEntry: @a-propos-de
        }
        link {
            target: {
                page: 10020
                clearCache: 10020
            }
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @fonctionnalité-a-propos-de-la-page
        }
    )

    entry aide-de-la-page (
        label: Aide de la page
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 30
            parentEntry: @a-propos-de
        }
        link {
            target: {
                page: 10021
                items: {
                    P10021_PAGE_ID: &APP_PAGE_ID.
                }
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @fonctionnalité-a-propos-de-la-page
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
        serverSideCondition {
            type: never
        }
    )

    entry fermer-la-session (
        label: Fermer la session
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 80
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: never
        }
    )

    entry informations-en-retour (
        label: Informations en retour
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10010
                items: {
                    P10010_PAGE_ID: &APP_PAGE_ID.
                }
                clearCache: 10010
                action: resetPagination
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @fonctionnalité-informations-en-retour
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 40
            parentEntry: @a-propos-de
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry list_item-2 (
        label: ---
        layout {
            sequence: 70
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

)

list informations-en-retour (
    name: Informations en retour
    config {
        buildOption: @fonctionnalité-informations-en-retour
    }

    entry informations-en-retour-des-utilisateurs (
        label: Informations en retour des utilisateurs
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10013
                clearCache: 10013
            }
        }
        userDefinedAttributes {
            1: Etat de l'ensemble des informations en retour envoyées par les utilisateurs de l'application
        }
    )

)

list menu-de-navigation-du-bureau (
    name: Menu de navigation du bureau

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-user-wrench
        }
        layout {
            sequence: 10000
        }
        link {
            target: {
                page: 10000
            }
        }
        security {
            authorizationScheme: @droits-d-administration
        }
    )

    entry page-d-accueil (
        label: Page d'accueil
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

)

